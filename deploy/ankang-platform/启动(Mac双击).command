#!/bin/bash
# =============================================================================
# 安康智慧平台 - Mac 双击启动 (.command)
# 右键 → 打开（首次运行允许）
# 功能与 start.sh 相同，只是 Mac 用户可以直接双击 .command 文件
# =============================================================================
DIR="$( cd "$( dirname "$0" )" && pwd )"
cd "$DIR"
exec bash "$DIR/start.sh"

